# Public Cardano deployment configuration. Operations → Team wallet reads the
# connected Eternl account; it does not need separate receiving addresses.
# Copy this file to .env.local, then set only the values needed for your
# workflows. Never put seed phrases, signing keys, payment keys, or API keys in
# any NEXT_PUBLIC_ variable.
# See docs/ENVIRONMENT_VARIABLES.md for the complete configuration reference.

# Use "mainnet" for production or "preprod" for the Cardano pre-production network.
NEXT_PUBLIC_CARDANO_NETWORK=preprod

# Public payment key hash for team-authorized recovery and shared-pool control.
NEXT_PUBLIC_TEAM_KEY_HASH=

# Optional local overrides; leave blank to use marketplace-deployment.preprod.json.
# Amplify build:preprod always takes these identities from the committed manifest.
NEXT_PUBLIC_SIMPLE_ORDERBOOK_ADDRESS=
NEXT_PUBLIC_QUOTE_POOL_ADDRESS=

# Server-only Blockfrost project IDs. These must not use the NEXT_PUBLIC_
# prefix, otherwise they will be included in browser JavaScript.
#
# The Cardano Preprod API and Blockfrost IPFS API are separate services and
# require separate project IDs.
BLOCKFROST_PROJECT_ID=
BLOCKFROST_IPFS_PROJECT_ID=

# Optional local registry overrides (Preprod); normally use the manifest defaults.
# Both are public identifiers, never private signing keys.
NEXT_PUBLIC_ASSET_REGISTRY_TOKEN=
NEXT_PUBLIC_ASSET_REGISTRY_ISSUER=

# Optional default token unit for the USDCx side of a DEX bootstrap offer.
NEXT_PUBLIC_USDCX_UNIT=
