# Public Cardano deployment addresses used by the Wallets directory.
# Copy this file to .env.local, then replace every value with the applicable
# public receiving or script address. Never put seed phrases, signing keys,
# payment keys, or API keys in any NEXT_PUBLIC_ variable.

# Use "mainnet" for production or "preprod" for the Cardano pre-production network.
NEXT_PUBLIC_CARDANO_NETWORK=preprod

# Operational public addresses
NEXT_PUBLIC_ISSUER_WALLET=
NEXT_PUBLIC_CUSTODY_WALLET=
NEXT_PUBLIC_TREASURY_WALLET=
NEXT_PUBLIC_SETTLEMENT_WALLET=

# Script address that locks the RWA NFT while it is fractionalized.
NEXT_PUBLIC_VAULT_ADDRESS=
