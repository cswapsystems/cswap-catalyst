# Public Cardano deployment addresses used by the Wallets directory.
# Copy this file to .env.local, then replace every value with the applicable
# public receiving or script address. Never put seed phrases, signing keys,
# payment keys, or API keys in any NEXT_PUBLIC_ variable.

# Use "mainnet" for production or "preprod" for the Cardano pre-production network.
NEXT_PUBLIC_CARDANO_NETWORK=preprod

# Operational public addresses
NEXT_PUBLIC_ISSUER_WALLET=
NEXT_PUBLIC_CUSTODY_WALLET=
NEXT_PUBLIC_TREASURY_WALLET=
NEXT_PUBLIC_SETTLEMENT_WALLET=

# Public payment key hash for team-authorized recovery and shared-pool control.
NEXT_PUBLIC_TEAM_KEY_HASH=

# Script address that locks the RWA NFT while it is fractionalized.
NEXT_PUBLIC_VAULT_ADDRESS=

# Registry-free orderbook / shared quote-pool deployments.
NEXT_PUBLIC_SIMPLE_ORDERBOOK_ADDRESS=
NEXT_PUBLIC_QUOTE_POOL_ADDRESS=

# Server-only Blockfrost project IDs. These must not use the NEXT_PUBLIC_
# prefix, otherwise they will be included in browser JavaScript.
#
# The Cardano Preprod API and Blockfrost IPFS API are separate services and
# require separate project IDs.
BLOCKFROST_PROJECT_ID=
BLOCKFROST_IPFS_PROJECT_ID=

# Basic on-chain asset registry (Preprod). Create it at /registry, then copy
# the confirmed deployment's identity asset unit and issuer payment key hash.
# Both are public identifiers, never private signing keys.
NEXT_PUBLIC_ASSET_REGISTRY_TOKEN=
NEXT_PUBLIC_ASSET_REGISTRY_ISSUER=
