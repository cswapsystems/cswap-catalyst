# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache/
/.data/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/dex-deployment.preprod.pending.json

# next.js
/.next/
/.next-review/
/out/

# production
/build
/infra/offchain/packaged.yaml
/infra/offchain/.aws-sam/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local Cardano credentials. Public addresses belong in .env.local; recovery
# phrases and signing keys must never be committed.
*.skey
*.mnemonic
seed.mnemonic

# Aiken dependency/build cache. Keep contract source, locks, and plutus.json.
/contracts/**/build/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
