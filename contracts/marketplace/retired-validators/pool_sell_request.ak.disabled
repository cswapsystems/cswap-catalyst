// Archived: legacy Instant Sell request escrow, superseded by
// marketplace_listing_escrow `InstantSell` listings. Owner cancellation of existing
// request outputs uses the pinned compiled script in
// ../legacy-request-recovery.json, not this source. Do not deploy.
use aiken/collection/list
use cardano/address.{Address}
use cardano/assets
use cardano/transaction.{Output, OutputReference, Transaction, find_input}
use ebecca/types.{AssetClass, ada, quantity_of}

// A seller-owned escrow submitted to the shared quote pool. Unlike a direct
// listing, it is not publicly purchasable: the pool batcher either settles it
// atomically against the pool or the seller cancels and recovers the asset.
pub type PoolSellRequestDatum {
  seller: Address,
  seller_key: VerificationKeyHash,
  pool_token: AssetClass,
  rwa: AssetClass,
  quantity: Int,
  quote_asset: AssetClass,
  min_payout: Int,
}

pub type PoolSellRequestRedeemer {
  // Retained only so existing request UTxOs can be cancelled and recovered.
  // New Instant Sell orders use `marketplace_listing_escrow` instead.
  Settle
  Cancel
}

fn paid_at_least(
  outputs: List<Output>,
  recipient: Address,
  asset: AssetClass,
  amount: Int,
) -> Bool {
  list.any(
    outputs,
    fn(output) {
      output.address == recipient && (output.value |> quantity_of(asset)) >= amount
    },
  )
}

fn request_value(request: PoolSellRequestDatum, locked_lovelace: Int) -> assets.Value {
  assets.from_lovelace(locked_lovelace)
    |> assets.add(request.rwa.policy_id, request.rwa.asset_name, request.quantity)
}

/// Compatibility validator for already-created legacy sell requests.
/// Settlement is disabled; the seller may still reclaim escrowed assets.
validator pool_sell_request(_pool_address: Address) {
  spend(
    datum: Option<PoolSellRequestDatum>,
    redeemer: PoolSellRequestRedeemer,
    own_ref: OutputReference,
    tx: Transaction,
  ) {
    expect Some(request) = datum
    expect Some(own_input) = tx.inputs |> find_input(own_ref)
    let locked_lovelace = own_input.output.value |> quantity_of(ada())

    and {
      request.quantity > 0,
      request.min_payout > 0,
      request.rwa != ada(),
      request.quote_asset != request.rwa,
      own_input.output.value == request_value(request, locked_lovelace),
      when redeemer is {
        // Settlement moved to the shared P2P listing path. Retain cancellation
        // for already-created request UTxOs; new requests cannot be settled here.
        Settle -> False
        Cancel -> and {
          list.has(tx.extra_signatories, request.seller_key),
          paid_at_least(tx.outputs, request.seller, request.rwa, request.quantity),
          paid_at_least(tx.outputs, request.seller, ada(), locked_lovelace),
        }
      },
    }
  }

  else(_) {
    fail
  }
}
